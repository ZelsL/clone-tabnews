{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Um projeto para aprender programação seguindo o curso.dev",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && (trap 'npm run services:stop' INT TERM ; next dev)",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development  up ",
    "migrations:up:dry": "node-pg-migrate -m infra/migrations --envPath .env.development  --dry-run up",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "npx eslint .",
    "lint:eslint:fix": "npx eslint . --fix",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "cookie": "1.0.2",
    "next": "14.2.5",
    "next-connect": "1.0.0",
    "node-pg-migrate": "7.6.1",
    "nodemailer": "7.0.5",
    "pg": "8.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "swr": "2.5.1",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.4.0",
    "@commitlint/config-conventional": "19.2.2",
    "@eslint/js": "9.39.5",
    "@faker-js/faker": "9.7.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "commitizen": "4.3.2",
    "concurrently": "8.2.2",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^1000.0.0",
    "eslint": "9.9.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jest": "28.8.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "prettier": "3.9.6",
    "secretlint": "13.0.5",
    "set-cookie-parser": "2.7.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  }
}
